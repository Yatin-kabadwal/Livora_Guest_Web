# Copy this file to .env.local for local development.
#
# On VERCEL: Project Settings -> Environment Variables, add both:
#   NEXT_PUBLIC_API_URL  = https://<your-render-app>.onrender.com/api   (must end with /api, no trailing slash)
#   NEXT_PUBLIC_SITE_URL = https://<your-guest-site-domain>            (used for canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
